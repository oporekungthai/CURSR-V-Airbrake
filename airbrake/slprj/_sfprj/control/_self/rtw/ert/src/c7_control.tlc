%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   4 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "tick"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "control:23:138-142"\
    }\
    ChartData {\
      Name         "u_store"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "control:23:143-150"\
    }\
    ChartData {\
      Name         "bf_store"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "control:23:151-159"\
    }\
    ChartData {\
      Name         "f_store"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "control:23:160-167"\
    }\
  }
  %return ChartDataElements
%endfunction
